{
  "openapi": "3.1.0",
  "info": {
    "title": "Loomwork HTTP API",
    "description": "JSON API the loomwork browser UI runs on, served by `loomwork serve` over loopback only. It is a handler layer over internal/store: every response document is a stored domain document, so this description doubles as the contract for scripts and agents that read a workspace without shelling out to the CLI. There is no authentication because the server is single-user, local-first, and never reachable from another host.",
    "version": "0.1.0",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "security": [],
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "Default `loomwork serve` address; --addr changes the port."
    }
  ],
  "tags": [
    {"name": "meta", "description": "Server and workspace introspection."},
    {"name": "projects", "description": "Projects and their document sources."},
    {"name": "requirements", "description": "Versioned, immutable requirement snapshots."},
    {"name": "desktop", "description": "Project tree, typed viewers, model discovery, and streamed chat."}
  ],
  "paths": {
    "/api/openapi.json": {
      "get": {
        "tags": ["meta"],
        "operationId": "getOpenAPIDocument",
        "summary": "This description of the API.",
        "responses": {
          "200": {
            "description": "The OpenAPI document embedded in the binary.",
            "content": {
              "application/json": {
                "schema": {"type": "object"}
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": ["meta"],
        "operationId": "getHealth",
        "summary": "Liveness check.",
        "responses": {
          "200": {
            "description": "The server is serving requests.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {"type": "string", "const": "ok"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/workspace": {
      "get": {
        "tags": ["meta"],
        "operationId": "getWorkspace",
        "summary": "Which workspace this server edits.",
        "description": "Lets a client show the workspace it is editing, so a UI opened against the wrong LOOMWORK_HOME is obvious.",
        "responses": {
          "200": {
            "description": "Workspace locations.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Workspace"}
              }
            }
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "tags": ["desktop"],
        "operationId": "listModels",
        "summary": "List configured text providers and their available models.",
        "description": "A provider discovery failure stays on that provider row and does not hide other configured providers. Configured default and preset-backed models remain selectable when live discovery is unavailable.",
        "responses": {
          "200": {
            "description": "Configured provider/model choices.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/ProviderModels"}
                }
              }
            }
          },
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/api/projects": {
      "get": {
        "tags": ["projects"],
        "operationId": "listProjects",
        "summary": "Summarize every project.",
        "description": "Each row is built from the project document alone, including the counts the store caches, so listing many projects never scans their subfolders.",
        "responses": {
          "200": {
            "description": "Project summaries.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/ProjectSummary"}
                }
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"}
        }
      },
      "post": {
        "tags": ["projects"],
        "operationId": "createProject",
        "summary": "Create a project.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/CreateProjectRequest"}
            }
          }
        },
        "responses": {
          "201": {
            "description": "The stored project document.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Project"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"}
        }
      }
    },
    "/api/projects/{projectRef}": {
      "parameters": [{"$ref": "#/components/parameters/ProjectRef"}],
      "get": {
        "tags": ["projects"],
        "operationId": "getProject",
        "summary": "Fetch one project document.",
        "description": "Returns metadata, document sources, cached counts, and artifacts.",
        "responses": {
          "200": {
            "description": "The stored project document.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Project"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/projects/{projectRef}/sources": {
      "parameters": [{"$ref": "#/components/parameters/ProjectRef"}],
      "get": {
        "tags": ["projects"],
        "operationId": "listSources",
        "summary": "List a project's document source links.",
        "responses": {
          "200": {"$ref": "#/components/responses/SourceList"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      },
      "post": {
        "tags": ["projects"],
        "operationId": "addSource",
        "summary": "Attach or update a document source link.",
        "description": "Posting a source whose name already exists updates that link instead of duplicating it, matching the CLI.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/DocumentSource"}
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/SourceList"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/projects/{projectRef}/requirements": {
      "parameters": [{"$ref": "#/components/parameters/ProjectRef"}],
      "get": {
        "tags": ["requirements"],
        "operationId": "listRequirements",
        "summary": "List the current version of every requirement.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Return only requirements whose current version has this status.",
            "schema": {"$ref": "#/components/schemas/RequirementStatus"}
          }
        ],
        "responses": {
          "200": {"$ref": "#/components/responses/RequirementList"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      },
      "post": {
        "tags": ["requirements"],
        "operationId": "createRequirement",
        "summary": "Create a requirement at version 1.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/RequirementWrite"}
            }
          }
        },
        "responses": {
          "201": {"$ref": "#/components/responses/RequirementVersion"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/projects/{projectRef}/requirements/{requirementId}": {
      "parameters": [
        {"$ref": "#/components/parameters/ProjectRef"},
        {"$ref": "#/components/parameters/RequirementID"}
      ],
      "get": {
        "tags": ["requirements"],
        "operationId": "getRequirement",
        "summary": "Fetch one requirement version.",
        "parameters": [{"$ref": "#/components/parameters/Version"}],
        "responses": {
          "200": {"$ref": "#/components/responses/RequirementVersion"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      },
      "put": {
        "tags": ["requirements"],
        "operationId": "amendRequirement",
        "summary": "Amend the current requirement version in place.",
        "description": "Rewrites the current version without changing its version, status, or creation timestamp. Fields left empty inherit from the current version. `status` is rejected — use the status endpoint to change a status.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/RequirementUpdate"}
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/RequirementVersion"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      },
      "patch": {
        "tags": ["requirements"],
        "operationId": "updateRequirement",
        "summary": "Write the next requirement version.",
        "description": "The new version is active and the previous one becomes superseded; earlier versions stay readable. `status` is rejected here — use the status endpoint to change a status.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/RequirementUpdate"}
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/RequirementVersion"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/projects/{projectRef}/requirements/{requirementId}/history": {
      "parameters": [
        {"$ref": "#/components/parameters/ProjectRef"},
        {"$ref": "#/components/parameters/RequirementID"}
      ],
      "get": {
        "tags": ["requirements"],
        "operationId": "getRequirementHistory",
        "summary": "List every retained version, oldest first.",
        "responses": {
          "200": {"$ref": "#/components/responses/RequirementList"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/projects/{projectRef}/requirements/{requirementId}/status": {
      "parameters": [
        {"$ref": "#/components/parameters/ProjectRef"},
        {"$ref": "#/components/parameters/RequirementID"}
      ],
      "post": {
        "tags": ["requirements"],
        "operationId": "setRequirementStatus",
        "summary": "Set one version's status.",
        "description": "Changes a status in place rather than writing a new version, so marking a requirement obsolete does not invent history.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/StatusRequest"}
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/RequirementVersion"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/projects/{projectRef}/items": {
      "parameters": [{"$ref": "#/components/parameters/ProjectRef"}],
      "get": {
        "tags": ["desktop"],
        "operationId": "listProjectItems",
        "summary": "Build the Agent Desktop entity tree.",
        "description": "Returns requirements, agent definitions, override rules, test suites and nested cases, report files, and latest free-form artifact revisions grouped by their project subfolder.",
        "responses": {
          "200": {
            "description": "Grouped project tree.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/TreeResponse"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/projects/{projectRef}/items/{family}/{itemRef}": {
      "parameters": [
        {"$ref": "#/components/parameters/ProjectRef"},
        {"$ref": "#/components/parameters/ItemFamily"},
        {"$ref": "#/components/parameters/ItemRef"}
      ],
      "get": {
        "tags": ["desktop"],
        "operationId": "getProjectItem",
        "summary": "Read one typed viewer document.",
        "description": "The artifactType and mediaType select the frontend viewer registry. Unknown values remain valid and use the raw fallback.",
        "parameters": [{"$ref": "#/components/parameters/Version"}],
        "responses": {
          "200": {
            "description": "Viewer registry input.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ViewerDocument"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/projects/{projectRef}/chat": {
      "parameters": [{"$ref": "#/components/parameters/ProjectRef"}],
      "post": {
        "tags": ["desktop"],
        "operationId": "streamProjectChat",
        "summary": "Stream one assistant turn with Server-Sent Events.",
        "description": "The stream emits ready, message, done, or error events. Message data contains a delta field. This provider-neutral wire format remains stable when AgentAdapter streaming replaces the initial TextGenerator implementation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/ChatRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-Sent Event stream.",
            "content": {
              "text/event-stream": {
                "schema": {"type": "string"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ProjectRef": {
        "name": "projectRef",
        "in": "path",
        "required": true,
        "description": "Project id (`prj-...`) or project name.",
        "schema": {"type": "string", "minLength": 1}
      },
      "RequirementID": {
        "name": "requirementId",
        "in": "path",
        "required": true,
        "description": "Requirement identity, stable across versions.",
        "schema": {"type": "string", "pattern": "^req-[0-9]{3,}$"}
      },
      "ItemFamily": {
        "name": "family",
        "in": "path",
        "required": true,
        "description": "Typed project subfolder or nested test-case family.",
        "schema": {
          "type": "string",
          "enum": ["requirements", "agent-definitions", "override-rules", "test-suites", "test-cases", "reports", "artifacts"]
        }
      },
      "ItemRef": {
        "name": "itemRef",
        "in": "path",
        "required": true,
        "description": "Entity id or name. Test-case refs use suite-id~case-id.",
        "schema": {"type": "string", "minLength": 1}
      },
      "Version": {
        "name": "version",
        "in": "query",
        "required": false,
        "description": "Retained version to read. Omitted means the current version.",
        "schema": {"type": "integer", "minimum": 1}
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request was rejected: an unparseable body, an unknown field, or a value the domain refused.",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/Error"}
          }
        }
      },
      "NotFound": {
        "description": "No such endpoint, project, or requirement version.",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/Error"}
          }
        }
      },
      "ServiceUnavailable": {
        "description": "The desktop provider service was not configured.",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/Error"}
          }
        }
      },
      "SourceList": {
        "description": "The project's document source links.",
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {"$ref": "#/components/schemas/DocumentSource"}
            }
          }
        }
      },
      "RequirementList": {
        "description": "Requirement version snapshots.",
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {"$ref": "#/components/schemas/Requirement"}
            }
          }
        }
      },
      "RequirementVersion": {
        "description": "One requirement version snapshot.",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/Requirement"}
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {"type": "string", "description": "Human-readable reason the request failed."}
        }
      },
      "Workspace": {
        "type": "object",
        "required": ["home", "projectsDir"],
        "properties": {
          "home": {"type": "string", "description": "Workspace root (LOOMWORK_HOME)."},
          "projectsDir": {"type": "string", "description": "Directory holding one folder per project."}
        }
      },
      "ProviderModels": {
        "type": "object",
        "required": ["provider", "kind", "status", "models"],
        "properties": {
          "provider": {"type": "string"},
          "kind": {"type": "string", "enum": ["ollama", "lmstudio", "azure", "bedrock"]},
          "status": {"type": "string"},
          "models": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/ModelChoice"}
          }
        }
      },
      "ModelChoice": {
        "type": "object",
        "required": ["id", "selector", "presets"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "selector": {"type": "string", "description": "provider/model"},
          "presets": {"type": "array", "items": {"type": "string"}}
        }
      },
      "TreeResponse": {
        "type": "object",
        "required": ["groups"],
        "properties": {
          "groups": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/TreeGroup"}
          }
        }
      },
      "TreeGroup": {
        "type": "object",
        "required": ["family", "label", "items"],
        "properties": {
          "family": {"type": "string"},
          "label": {"type": "string"},
          "items": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/TreeItem"}
          }
        }
      },
      "TreeItem": {
        "type": "object",
        "required": ["ref", "name", "family", "artifactType", "mediaType"],
        "properties": {
          "ref": {"type": "string"},
          "name": {"type": "string"},
          "family": {"type": "string"},
          "artifactType": {"type": "string"},
          "mediaType": {"type": "string"},
          "version": {"type": "integer", "minimum": 1},
          "status": {"type": "string"},
          "children": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/TreeItem"}
          }
        }
      },
      "ViewerDocument": {
        "type": "object",
        "required": ["ref", "name", "family", "artifactType", "mediaType", "body"],
        "properties": {
          "ref": {"type": "string"},
          "name": {"type": "string"},
          "family": {"type": "string"},
          "artifactType": {"type": "string"},
          "mediaType": {"type": "string"},
          "version": {"type": "integer", "minimum": 1},
          "body": {},
          "metadata": {"type": "object", "additionalProperties": {"type": "string"}}
        }
      },
      "ChatMessage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "enum": ["user", "assistant"]},
          "content": {"type": "string", "minLength": 1}
        }
      },
      "ChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selector", "messages"],
        "properties": {
          "selector": {"type": "string", "description": "provider/model[#preset]"},
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/components/schemas/ChatMessage"}
          },
          "artifactRefs": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Optional artifact ids or names to attach as grounding context."
          }
        }
      },
      "CreateProjectRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "sources": {
            "type": "array",
            "description": "Document source links to attach as part of creation.",
            "items": {"$ref": "#/components/schemas/DocumentSource"}
          }
        }
      },
      "Project": {
        "type": "object",
        "required": ["id", "name", "createdAt", "updatedAt", "artifacts"],
        "properties": {
          "id": {"type": "string", "pattern": "^prj-"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "sources": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/DocumentSource"}
          },
          "createdAt": {"type": "string", "format": "date-time"},
          "updatedAt": {"type": "string", "format": "date-time"},
          "artifacts": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/Artifact"}
          },
          "index": {"$ref": "#/components/schemas/ProjectIndex"}
        }
      },
      "ProjectIndex": {
        "type": "object",
        "description": "Counts the store caches in the project document so a landing view need not scan subfolders.",
        "required": ["requirements", "activeRequirements"],
        "properties": {
          "requirements": {"type": "integer", "minimum": 0},
          "activeRequirements": {"type": "integer", "minimum": 0}
        }
      },
      "ProjectSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "sources",
          "requirements",
          "activeRequirements",
          "artifacts",
          "createdAt",
          "updatedAt",
          "testability"
        ],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "sources": {"type": "integer", "minimum": 0},
          "requirements": {"type": "integer", "minimum": 0},
          "activeRequirements": {"type": "integer", "minimum": 0},
          "artifacts": {"type": "integer", "minimum": 0},
          "createdAt": {"type": "string", "format": "date-time"},
          "updatedAt": {"type": "string", "format": "date-time"},
          "testability": {"$ref": "#/components/schemas/Testability"}
        }
      },
      "Testability": {
        "type": "object",
        "description": "Per-project health rollup. Its fields are derived from execution reports and test-case coverage, which arrive in later phases, so they are null until then and `available` says so rather than a client having to guess whether a zero means \"none\" or \"unknown\".",
        "required": ["available", "lastTestedAt", "coveragePercent", "openGaps"],
        "properties": {
          "available": {"type": "boolean"},
          "lastTestedAt": {"type": ["string", "null"], "format": "date-time"},
          "coveragePercent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "openGaps": {"type": ["integer", "null"], "minimum": 0}
        }
      },
      "DocumentSource": {
        "type": "object",
        "additionalProperties": false,
        "description": "A link to documentation a requirement can cite. Loomwork stores the link, not the document.",
        "required": ["name", "type"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"$ref": "#/components/schemas/SourceType"},
          "url": {"type": "string", "description": "http(s) URL of the document."},
          "localPath": {"type": "string"},
          "s3Uri": {"type": "string"}
        }
      },
      "Artifact": {
        "type": "object",
        "description": "Immutable, versioned unit of project material. Metadata such as tags and the pinned flag may change; the body never does.",
        "required": ["id", "name", "type", "version", "pinned", "body", "createdAt"],
        "properties": {
          "id": {"type": "string", "pattern": "^art-"},
          "name": {"type": "string"},
          "type": {
            "type": "string",
            "enum": ["spec", "log", "test-result", "diagram", "doc", "generated"]
          },
          "version": {"type": "integer", "minimum": 1},
          "tags": {"type": "array", "items": {"type": "string"}},
          "pinned": {
            "type": "boolean",
            "description": "Pinned artifacts form the standing context supplied to prompt runs."
          },
          "parentId": {"type": "string", "description": "Artifact this one was derived from."},
          "body": {"$ref": "#/components/schemas/ArtifactBody"},
          "metadata": {"type": "object", "additionalProperties": {"type": "string"}},
          "createdAt": {"type": "string", "format": "date-time"}
        }
      },
      "ArtifactBody": {
        "type": "object",
        "additionalProperties": false,
        "description": "Carries either inline content or an external reference, never both.",
        "properties": {
          "content": {"type": "string"},
          "ref": {"type": "string"},
          "mediaType": {"type": "string"}
        },
        "oneOf": [{"required": ["content"]}, {"required": ["ref"]}]
      },
      "SourceType": {
        "type": "string",
        "description": "System of record for the originating documentation.",
        "enum": ["ado", "confluence", "github", "other"]
      },
      "RequirementStatus": {
        "type": "string",
        "description": "Whether a requirement version is still testable. Superseded and obsolete versions are retained for audit rather than deleted.",
        "enum": ["active", "obsolete", "superseded"]
      },
      "RequirementOrigin": {
        "type": "string",
        "description": "How a requirement version was produced.",
        "enum": ["authored", "extracted"]
      },
      "RequirementWrite": {
        "type": "object",
        "additionalProperties": false,
        "description": "The writable half of a requirement: the stored document minus id, version, and created_at, which the store assigns. Empty fields take domain defaults on create and inherit from the current version on update.",
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "source_type": {"$ref": "#/components/schemas/SourceType"},
          "source_ref": {
            "type": "string",
            "description": "Requires source_type; a reference without a system of record is rejected."
          },
          "status": {"$ref": "#/components/schemas/RequirementStatus"},
          "origin": {"$ref": "#/components/schemas/RequirementOrigin"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "metadata": {"type": "object", "additionalProperties": {"type": "string"}}
        }
      },
      "RequirementUpdate": {
        "description": "The fields of a new requirement version. Fields left empty inherit from the current version, and `status` is rejected: an update always writes an active version.",
        "allOf": [{"$ref": "#/components/schemas/RequirementWrite"}]
      },
      "Requirement": {
        "type": "object",
        "additionalProperties": false,
        "description": "One immutable version snapshot, as stored in requirements/<id>.v<version>.json. The full constraints live in docs/schemas/requirement.schema.json.",
        "required": ["id", "version", "text", "status", "origin", "created_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^req-[0-9]{3,}$"},
          "version": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1},
          "source_type": {"$ref": "#/components/schemas/SourceType"},
          "source_ref": {"type": "string"},
          "status": {"$ref": "#/components/schemas/RequirementStatus"},
          "origin": {"$ref": "#/components/schemas/RequirementOrigin"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "metadata": {"type": "object", "additionalProperties": {"type": "string"}},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "StatusRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {"$ref": "#/components/schemas/RequirementStatus"},
          "version": {
            "type": "integer",
            "minimum": 0,
            "description": "Version to change. 0 or omitted changes the current version."
          }
        }
      }
    }
  }
}
